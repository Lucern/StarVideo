<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarVideo.Controls.NavTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="48">

    <Grid x:Name="Root" Background="Transparent" Padding="6,0"
          Tapped="OnTapped" PointerEntered="OnPointerEntered" PointerExited="OnPointerExited"
          PointerPressed="OnPointerPressed" PointerReleased="OnPointerReleased">
        <Border x:Name="HoverLayer" Background="{ThemeResource HoverScrimBrush}"
                CornerRadius="6" Margin="4,8" Visibility="Collapsed" />
        <TextBlock x:Name="Label" Text="" FontSize="13.5" FontWeight="SemiBold"
                   Foreground="{ThemeResource TextPrimaryBrush}" Opacity="0.6"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border x:Name="Underline" Height="3" Width="26" CornerRadius="2"
                Background="{ThemeResource AccentBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                Visibility="Collapsed" />
    </Grid>
</UserControl>
