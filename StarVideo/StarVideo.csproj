<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10：Windows App SDK / WinUI 3 仍以 windows10.0.19041.0 作为目标平台版本，无需随之提高 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>StarVideo</RootNamespace>
    <AssemblyName>StarVideo</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefaultLanguage>zh-CN</DefaultLanguage>

    <!-- 非 MSIX 打包：直接生成可双击运行的 exe；自包含 Windows App SDK 运行时，免装 Runtime -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <ApplicationIcon>Assets\Brand\app.ico</ApplicationIcon>
    <Company>Pit</Company>
    <Product>星影视频</Product>
    <Version>1.0.0</Version>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK 2.6.5：当前 NuGet 上的最新稳定版（WinUI 3）。
         2.x 起运行时被拆分为 Base / Foundation / WinUI / Runtime 等子包，仍由这个元包统一引入。 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\**\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- FFmpeg 静态构建随程序发布，用于任意格式的本地解码 / 转封装 / 元数据探测 -->
    <Content Include="Tools\ffmpeg\LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Tools\ffmpeg\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Tools\ffmpeg\ffprobe.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
