<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StarVideo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:StarVideo.Controls"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}"
          SizeChanged="OnRootSizeChanged">
        <Grid.RowDefinitions>
            <!-- 第 0 行：自绘标题栏（窗口拖拽区） -->
            <RowDefinition x:Name="TitleBarRow" Height="48" />
            <!-- 第 1 行：频道导航（普通内容区，绝不能设为标题栏） -->
            <RowDefinition x:Name="NavBarRow" Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 自绘标题栏 ==================== -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{ThemeResource TopBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>

            <!-- Logo：标题栏里必须用可交互控件，StackPanel+Tapped 会被系统当作拖拽窗口 -->
            <Button x:Name="LogoButton" Grid.Column="0" Margin="16,0,14,0" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center" Click="OnLogoTapped"
                    ToolTipService.ToolTip="回到首页">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Border Width="28" Height="28" CornerRadius="8"
                            Background="{StaticResource AccentGradientBrush}">
                        <Polygon Points="10,6 10,22 23,14" Fill="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="LogoText" Text="星影视频" FontSize="16" FontWeight="Bold"
                               Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 后退 / 前进 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource IconButtonStyle}"
                        Width="32" Height="32" Click="OnBackClick" ToolTipService.ToolTip="后退">
                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                </Button>
                <Button x:Name="ForwardButton" Style="{StaticResource IconButtonStyle}"
                        Width="32" Height="32" Click="OnForwardClick" ToolTipService.ToolTip="前进">
                    <FontIcon Glyph="&#xE72A;" FontSize="13" />
                </Button>
            </StackPanel>

            <!-- 第 2 列留白：窗口拖拽区 -->

            <!-- 搜索 -->
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="3" Width="240" Height="32"
                            VerticalAlignment="Center" Margin="8,0,10,0"
                            PlaceholderText="搜影片 / 演员 / 类型" QueryIcon="Find"
                            FontSize="12.5" TextChanged="OnSearchTextChanged"
                            QuerySubmitted="OnSearchQuerySubmitted" />

            <!-- 右侧功能入口 -->
            <StackPanel x:Name="ActionButtons" Grid.Column="4" Orientation="Horizontal"
                        VerticalAlignment="Center" Spacing="2">
                <Button x:Name="LibraryButton" Style="{StaticResource IconButtonStyle}" Click="OnLibraryClick"
                        ToolTipService.ToolTip="我的片单">
                    <FontIcon Glyph="&#xE728;" FontSize="16" />
                </Button>
                <Button x:Name="HistoryButton" Style="{StaticResource IconButtonStyle}" Click="OnHistoryClick"
                        ToolTipService.ToolTip="观看历史">
                    <FontIcon Glyph="&#xE823;" FontSize="16" />
                </Button>
                <Button x:Name="VipButton" Margin="4,0,6,0" Padding="12,6" CornerRadius="14"
                        Background="#33FFB44A" Foreground="#FFFFC97A" BorderThickness="0"
                        FontSize="12" FontWeight="Bold" Content="VIP" Click="OnVipClick" />
                <Button Style="{StaticResource IconButtonStyle}" Width="36" Height="36"
                        ToolTipService.ToolTip="账号与设置">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="我的片单" Click="OnLibraryClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE728;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="设置" Click="OnSettingsMenuClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="关于星影视频" Click="OnAboutClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE77B;" FontSize="18" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 频道导航（独立一行，可点击 + 可横向滚动） ==================== -->
        <Grid x:Name="NavBar" Grid.Row="1" Background="{ThemeResource TopBarBrush}"
              BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <!-- 固定列宽：按钮隐藏时不改变 ScrollViewer 的 ViewportWidth，避免滚动状态震荡 -->
                <ColumnDefinition Width="38" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="38" />
            </Grid.ColumnDefinitions>

            <Button x:Name="TabLeftButton" Grid.Column="0" Width="30" Height="30" Margin="6,0,0,0"
                    VerticalAlignment="Center" Padding="0" Visibility="Collapsed"
                    Style="{StaticResource IconButtonStyle}" Click="OnTabScrollLeft"
                    ToolTipService.ToolTip="向左滚动频道">
                <FontIcon Glyph="&#xE76B;" FontSize="12" />
            </Button>

            <ScrollViewer x:Name="TabScroller" Grid.Column="1"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalAlignment="Stretch" Margin="4,0"
                          PointerWheelChanged="OnTabWheel" ViewChanged="OnTabViewChanged"
                          SizeChanged="OnTabScrollerSizeChanged">
                <StackPanel x:Name="TabPanel" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <controls:NavTab Text="首页" Tag="home" />
                    <controls:NavTab Text="电视剧" Tag="电视剧" />
                    <controls:NavTab Text="电影" Tag="电影" />
                    <controls:NavTab Text="综艺" Tag="综艺" />
                    <controls:NavTab Text="动漫" Tag="动漫" />
                    <controls:NavTab Text="纪录片" Tag="纪录片" />
                    <controls:NavTab Text="少儿" Tag="少儿" />
                    <controls:NavTab Text="排行榜" Tag="rank" />
                </StackPanel>
            </ScrollViewer>

            <Button x:Name="TabRightButton" Grid.Column="2" Width="30" Height="30" Margin="0,0,6,0"
                    VerticalAlignment="Center" Padding="0" Visibility="Collapsed"
                    Style="{StaticResource IconButtonStyle}" Click="OnTabScrollRight"
                    ToolTipService.ToolTip="向右滚动频道">
                <FontIcon Glyph="&#xE76C;" FontSize="12" />
            </Button>
        </Grid>

        <!-- ==================== 页面内容 ==================== -->
        <Frame x:Name="ContentFrame" Grid.Row="2" Background="Transparent" Navigated="OnFrameNavigated" />

        <TeachingTip x:Name="Toast" Title="星影视频" Subtitle=""
                     IsLightDismissEnabled="True" PreferredPlacement="BottomRight"
                     Grid.Row="2" />
    </Grid>
</Window>
