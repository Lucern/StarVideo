<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:StarVideo.Helpers">

    <helpers:ImagePathConverter x:Key="ImagePath" />
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    <helpers:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True" />
    <helpers:StringToVisibilityConverter x:Key="StrToVis" />
    <helpers:CountToVisibilityConverter x:Key="ZeroToVis" />

    <x:String x:Key="AppName">星影视频</x:String>
    <x:Double x:Key="PosterWidth">170</x:Double>

    <!-- 卡片底部通用压暗渐变（海报上叠白字，两种主题通用） -->
    <LinearGradientBrush x:Key="PosterShadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#99070910" Offset="0.62" />
        <GradientStop Color="#E6070910" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BannerShadeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D60B0C13" Offset="0" />
        <GradientStop Color="#660B0C13" Offset="0.45" />
        <GradientStop Color="#000B0C13" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF9A2E" Offset="0" />
        <GradientStop Color="#FFFF5B18" Offset="1" />
    </LinearGradientBrush>

    <!-- ============ 文本样式 ============ -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
    </Style>

    <!-- ============ 按钮 ============ -->
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="24,11" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                         To="0.86" Duration="0:0:0.12" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                         To="0.7" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                         To="0.4" Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#55FFFFFF" />
    </Style>

    <Style x:Key="ChipButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource ChipBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding Content}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                         To="0.8" Duration="0:0:0.12" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                         To="0.62" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="CardItemStyle" TargetType="GridViewItem">
        <Setter Property="Margin" Value="6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <Style x:Key="RowItemStyle" TargetType="ListViewItem">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- ============ 卡片模板 ============ -->
    <DataTemplate x:Key="PosterCardTemplate">
        <Grid Width="170" Margin="0,0,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="238" CornerRadius="9"
                  BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                <Grid.Background>
                    <ImageBrush ImageSource="{Binding PosterPath, Converter={StaticResource ImagePath}}"
                                Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                </Grid.Background>

                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8,8,0,0"
                        Background="#E6FF7A18" CornerRadius="4" Padding="7,3"
                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding CornerBadge}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </Border>

                <Border VerticalAlignment="Bottom" Height="70" Background="{StaticResource PosterShadeBrush}" />
                <Grid VerticalAlignment="Bottom" Margin="10,0,10,9">
                    <TextBlock Text="{Binding ScoreText}" FontSize="17" FontWeight="Bold"
                               Foreground="{ThemeResource ScoreBrush}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Duration}" FontSize="11" Foreground="#FFE9EBF2"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                </Grid>
            </Grid>

            <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="2,10,2,2" FontSize="14"
                       FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="2" Text="{Binding GenreText}" Margin="2,0,2,0" FontSize="11.5"
                       Foreground="{ThemeResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ContinueCardTemplate">
        <Grid Width="228" Margin="0,0,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Height="128" CornerRadius="8">
                <Grid.Background>
                    <ImageBrush ImageSource="{Binding PosterPath, Converter={StaticResource ImagePath}}"
                                Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                </Grid.Background>
                <Border VerticalAlignment="Bottom" Height="54" Background="{StaticResource PosterShadeBrush}" />
                <Border Width="34" Height="34" CornerRadius="17" Background="#99000000"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="#AAFFFFFF" BorderThickness="1">
                    <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Minimum="0"
                             VerticalAlignment="Bottom" Height="3" Margin="0"
                             Foreground="{ThemeResource AccentBrush}" Background="#55FFFFFF" />
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="2,9,2,2" FontSize="13.5"
                       FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="2" Text="{Binding EpisodeText}" Margin="2,0" FontSize="11"
                       Foreground="{ThemeResource TextMutedBrush}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="RankRowTemplate">
        <Grid Padding="12,10" ColumnSpacing="16" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="54" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding RankText}" FontSize="26" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="{ThemeResource TextMutedBrush}" />
            <Border Grid.Column="1" Width="54" Height="72" CornerRadius="5">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding PosterPath, Converter={StaticResource ImagePath}}"
                                Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                </Border.Background>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="5">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding MetaText}" FontSize="11.5"
                           Foreground="{ThemeResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                <TextBlock Text="{Binding ScoreText}" FontSize="17" FontWeight="Bold"
                           Foreground="{ThemeResource ScoreBrush}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding HotText}" FontSize="11"
                           Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
    </DataTemplate>




    <!-- 观看历史卡片：在继续观看卡片基础上显示进度文字 -->
    <DataTemplate x:Key="HistoryCardTemplate">
        <Grid Width="228" Margin="0,0,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Height="128" CornerRadius="8">
                <Grid.Background>
                    <ImageBrush ImageSource="{Binding PosterPath, Converter={StaticResource ImagePath}}"
                                Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                </Grid.Background>
                <Border VerticalAlignment="Bottom" Height="54" Background="{StaticResource PosterShadeBrush}" />
                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Minimum="0"
                             VerticalAlignment="Bottom" Height="3"
                             Foreground="{ThemeResource AccentBrush}" Background="#55FFFFFF" />
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="2,9,2,2" FontSize="13.5"
                       FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="2" Text="{Binding ProgressText}" Margin="2,0" FontSize="11"
                       Foreground="{ThemeResource TextMutedBrush}" />
        </Grid>
    </DataTemplate>

    <Style x:Key="HeroTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="SelectedChipStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 主题色板置于字典末尾：WinUI XamlCompiler 要求 ThemeDictionaries 之后不得再有资源 -->
    <!-- ============ 主题色板：深色为主，浅色可在「设置」里切换 ============ -->
    <!-- AppBackgroundBrush / TopBarBrush 只留一层很淡的半透明薄纱，
         好让窗口的 AcrylicThin 材质透出来；卡片、区块仍用不透明的 Surface/Card 保证文字可读。
         系统不支持材质时，MainWindow.ApplyTheme 会把根 Grid 换成不透明底色。 -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#330E0F14" />
            <SolidColorBrush x:Key="AppBackgroundAltBrush" Color="#E613151C" />
            <SolidColorBrush x:Key="TopBarBrush" Color="#4D101117" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FF191B23" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF252834" />
            <SolidColorBrush x:Key="CardBrush" Color="#FF171922" />
            <SolidColorBrush x:Key="ChipBrush" Color="#FF222531" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F6FA" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB7BCCB" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#FF7B8192" />
            <SolidColorBrush x:Key="BorderBrush" Color="#FF2B2E3B" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FFFF7A18" />
            <SolidColorBrush x:Key="AccentDeepBrush" Color="#FFE85C0B" />
            <SolidColorBrush x:Key="ScoreBrush" Color="#FFFFC24A" />
            <SolidColorBrush x:Key="HoverScrimBrush" Color="#22FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#33F5F6FA" />
            <SolidColorBrush x:Key="AppBackgroundAltBrush" Color="#E6ECEEF4" />
            <SolidColorBrush x:Key="TopBarBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FFE9ECF3" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ChipBrush" Color="#FFE9ECF3" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1C25" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF565C6C" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#FF8B91A1" />
            <SolidColorBrush x:Key="BorderBrush" Color="#FFDDE1EA" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FFEF6A08" />
            <SolidColorBrush x:Key="AccentDeepBrush" Color="#FFD95B00" />
            <SolidColorBrush x:Key="ScoreBrush" Color="#FFC97B00" />
            <SolidColorBrush x:Key="HoverScrimBrush" Color="#12000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>


</ResourceDictionary>
