<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarVideo.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 搜索框 -->
        <StackPanel Grid.Row="0" Padding="40,28,40,0" Spacing="16">
            <TextBlock Text="搜索" Style="{StaticResource PageTitleStyle}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchInput" Grid.Column="0" Height="44" FontSize="14"
                         PlaceholderText="输入片名、演员、类型或关键词" KeyDown="OnInputKeyDown"
                         VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="搜索" Style="{StaticResource AccentButtonStyle}"
                        Click="OnSearchClick" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="热搜" FontSize="12.5" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextMutedBrush}" />
                <StackPanel x:Name="HotChips" Orientation="Horizontal" />
            </StackPanel>
        </StackPanel>

        <!-- 结果头 -->
        <Grid Grid.Row="1" Margin="40,22,40,8">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="ResultTitle" Text="搜索结果" FontSize="17"
                           FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock x:Name="ResultCount" Text="" FontSize="12" VerticalAlignment="Bottom"
                           Margin="0,0,0,2" Foreground="{ThemeResource TextMutedBrush}" />
            </StackPanel>
            <StackPanel x:Name="SortChips" Orientation="Horizontal" HorizontalAlignment="Right" />
        </Grid>

        <!-- 结果区 -->
        <Grid Grid.Row="2" Margin="34,0,34,24">
            <GridView x:Name="ResultGrid"
                      ItemTemplate="{StaticResource PosterCardTemplate}"
                      ItemContainerStyle="{StaticResource CardItemStyle}"
                      SelectionMode="None" ItemClick="OnItemClick" />
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="14"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE721;" FontSize="46"
                          Foreground="{ThemeResource TextMutedBrush}" />
                <TextBlock x:Name="EmptyText" Text="没有找到相关作品" FontSize="15"
                           Foreground="{ThemeResource TextMutedBrush}" />
                <TextBlock Text="换个关键词，或试试上方的热搜词" FontSize="12"
                           Foreground="{ThemeResource TextMutedBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
