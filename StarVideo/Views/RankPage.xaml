<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarVideo.Views.RankPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="32,24,32,12" Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="🏆 排行榜" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="UpdateText" Text="" VerticalAlignment="Bottom" Margin="0,0,0,5"
                           Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <StackPanel x:Name="BoardChips" Orientation="Horizontal" />
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled">
                <StackPanel x:Name="CategoryChips" Orientation="Horizontal" />
            </ScrollViewer>
        </StackPanel>

        <Grid Grid.Row="1" Margin="32,8,32,24" ColumnSpacing="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource SurfaceBrush}" CornerRadius="12">
                <ListView x:Name="RankList" Padding="6,4"
                          ItemTemplate="{StaticResource RankRowTemplate}"
                          ItemContainerStyle="{StaticResource RowItemStyle}"
                          SelectionMode="None" ItemClick="OnItemClick" />
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollMode="Auto">
                <StackPanel Spacing="16">
                    <TextBlock Text="前列速览" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel x:Name="Podium" Spacing="12" />
                    <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="榜单说明" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Style="{StaticResource BodyTextStyle}"
                                       Text="数据来自本地演示片库，按热度 / 评分 / 年份实时排序。点击任意条目可查看详情并进入播放页。" />
                            <TextBlock Style="{StaticResource MutedTextStyle}"
                                       Text="演示版不连接任何真实视频服务，片名与海报均为原创占位内容。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
