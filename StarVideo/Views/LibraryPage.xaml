<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarVideo.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 头部：账号信息 -->
        <Border Grid.Row="0" Margin="32,24,32,0" Padding="24,20"
                Background="{ThemeResource SurfaceBrush}" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="62" Height="62" CornerRadius="31"
                        Background="{StaticResource AccentGradientBrush}" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE77B;" FontSize="28" Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="我的片单" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="SummaryText" Text="" FontSize="12.5"
                               Foreground="{ThemeResource TextMutedBrush}" />
                </StackPanel>
                <Border Grid.Column="2" VerticalAlignment="Center" Background="#33FFB44A"
                        CornerRadius="16" Padding="14,8">
                    <TextBlock Text="VIP 会员 · 演示版" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="#FFFFC97A" />
                </Border>
            </Grid>
        </Border>

        <!-- 标签栏 -->
        <Grid Grid.Row="1" Margin="32,20,32,8">
            <StackPanel x:Name="TabChips" Orientation="Horizontal" />
            <Button x:Name="ClearButton" HorizontalAlignment="Right" Content="清空"
                    Style="{StaticResource ChipButtonStyle}" Click="OnClearClick" />
        </Grid>

        <!-- 内容 -->
        <Grid Grid.Row="2" Margin="26,0,26,24">
            <GridView x:Name="ContentGrid" SelectionMode="None" ItemClick="OnItemClick" />
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="14"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE728;" FontSize="46"
                          Foreground="{ThemeResource TextMutedBrush}" />
                <TextBlock x:Name="EmptyTitle" Text="这里还空空的" FontSize="16"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
                <TextBlock x:Name="EmptyHint" Text="" FontSize="12"
                           Foreground="{ThemeResource TextMutedBrush}" />
                <Button Content="去首页逛逛" HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}" Click="OnGoHome" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
