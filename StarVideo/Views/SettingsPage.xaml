<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarVideo.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="40,28,40,48" Spacing="18" MaxWidth="900"
                    HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="所有偏好与观看数据都保存在本机，不上传任何服务器。"
                       Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6" />

            <!-- 外观 -->
            <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="22,18">
                <StackPanel Spacing="16">
                    <TextBlock Text="外观" FontSize="17" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="主题模式" FontSize="13.5"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="切换后立即生效，下次启动自动沿用。"
                                       FontSize="11.5" Foreground="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Right" Width="160"
                                  SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Content="深色主题" />
                            <ComboBoxItem Content="浅色主题" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 播放 -->
            <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="22,18">
                <StackPanel Spacing="16">
                    <TextBlock Text="播放" FontSize="17" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <Grid>
                        <StackPanel Spacing="4" Margin="0,0,24,0">
                            <TextBlock Text="自动播放下一集" FontSize="13.5"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="剧集播放结束后自动切到下一集（演示模式下为模拟进度）。"
                                       FontSize="11.5" Foreground="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoPlaySwitch" HorizontalAlignment="Right"
                                      OnContent="" OffContent="" Toggled="OnAutoPlayToggled" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource BorderBrush}" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="片源说明" FontSize="13.5"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="演示片库不含真实视频文件，播放页默认以海报 + 模拟进度演示交互；"
                                   Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="播放页可打开 / 拖入任意格式的本地视频（由 FFmpeg 处理），也可点击「在线」播放内置的公开测试片源；两者都支持拖动进度、音量与倍速。"
                                   Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- FFmpeg 解码 -->
            <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="22,18">
                <StackPanel Spacing="14">
                    <TextBlock Text="FFmpeg 解码" FontSize="17" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock x:Name="FFmpegStatusText" Text="" FontSize="12.5"
                               Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="打开本地视频时先用 ffprobe 探测编码：系统解码器支持则直接播放；容器不兼容（mkv/avi/ts 等）用 -c copy 重封装；编码不兼容（HEVC/AV1/VP9/DTS 等）用 libx264 + aac 转码。转码结果缓存在本地，同一文件不会重复处理。"
                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                    <Grid>
                        <StackPanel Spacing="4" Margin="0,0,24,0">
                            <TextBlock Text="始终经过 FFmpeg" FontSize="13.5"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="即使系统能直放也先重封装，便于验证 FFmpeg 链路。"
                                       FontSize="11.5" Foreground="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ForceFFmpegSwitch" HorizontalAlignment="Right"
                                      OnContent="" OffContent="" Toggled="OnForceFFmpegToggled" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource BorderBrush}" />
                    <TextBlock Text="自定义 FFmpeg 目录（留空则使用随程序发布的版本）" FontSize="12.5"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FFmpegPathBox" Grid.Column="0" PlaceholderText="例如 C:\Tools\ffmpeg\bin"
                                 Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="应用路径" Style="{StaticResource ChipButtonStyle}"
                                Click="OnApplyFFmpegPath" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="打开 FFmpeg 目录" Style="{StaticResource ChipButtonStyle}"
                                Click="OnOpenFFmpegFolder" />
                        <Button x:Name="ClearCacheButton" Content="清空转码缓存" Style="{StaticResource ChipButtonStyle}"
                                Click="OnClearTranscodeCache" />
                        <TextBlock x:Name="CacheSizeText" Text="" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 数据 -->
            <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="22,18">
                <StackPanel Spacing="16">
                    <TextBlock Text="数据管理" FontSize="17" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock x:Name="StatsText" Text="" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock x:Name="PathText" Text="" FontSize="11.5"
                               Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="清空观看记录" Style="{StaticResource ChipButtonStyle}"
                                Click="OnClearHistory" />
                        <Button Content="清空收藏" Style="{StaticResource ChipButtonStyle}"
                                Click="OnClearFavorites" />
                        <Button Content="打开数据目录" Style="{StaticResource ChipButtonStyle}"
                                Click="OnOpenDataFolder" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="22,18">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于" FontSize="17" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="星影视频  v1.0.0" FontSize="14"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="基于 WinUI 3 / Windows App SDK 1.8 / .NET 8 构建的桌面影音客户端界面演示。"
                               Style="{StaticResource BodyTextStyle}" />
                    <TextBlock Text="片名、海报、焦点图、评分与简介均为本地生成的原创虚构素材，与任何真实平台、作品或人物无关；除用户主动播放的公开测试视频外不连接任何服务，不采集数据。"
                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
